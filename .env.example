# CRM Local - Environment Variables Template
# All secrets and host ports must be configured here or generated by start.sh

# Environment Execution Mode (development, testing, production)
ENVIRONMENT=production

# Host Dynamic Port Allocations
HOST_PORT_PROXY=
HOST_PORT_FRONTEND=
HOST_PORT_BACKEND=
HOST_PORT_DB=
HOST_PORT_REDIS=

# Network Binding Interfaces
HOST_BIND_IP=127.0.0.1
PROXY_BIND_IP=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Redis Cache and Queue Configuration
REDIS_PASSWORD=
REDIS_PORT=6379

# Cryptographic and Application Keys
APP_SECRET_KEY=
JWT_SECRET=

# Scraper Engine Parameters
SCRAPER_CONCURRENCY_LIMIT=5
SCRAPER_REQUEST_TIMEOUT_SECONDS=30
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36

# CORS and Network Permissions
CORS_ORIGINS=*
